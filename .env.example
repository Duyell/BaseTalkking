# ============================================================
# BaseTalkking 生产环境变量模板
# 复制此文件为 .env 并修改所有占位符
#    cp .env.example .env
# ============================================================

# MySQL root 密码（必填，建议 16 位以上随机字符）
MYSQL_ROOT_PASSWORD=change-me-to-a-strong-password

# MySQL 应用用户密码（必填，需与 migrations/004_app_user.sql 中一致）
DB_MYSQL_USER=app_user
DB_MYSQL_PASSWORD=app_user_password_change_me

# Redis 密码（可选，留空则无密码）
REDIS_PASSWORD=

# JWT 签名密钥（必填，建议 32 位以上随机字符串）
# 生成方式: openssl rand -base64 32
JWT_SECRET=change-me-to-a-strong-random-string-32-chars-minimum

# OpenAI / DeepSeek API Key（必填）
OPENAI_API_KEY=sk-your-api-key-here
